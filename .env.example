# ── Supabase ────────────────────────────────────────────────────────────────
# Source of truth for the schema is supabase/migrations. Wire your own project.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Property data + skip-trace (default provider: BatchData) ─────────────────
PROPERTY_PROVIDER=mock        # mock | batchdata
BATCHDATA_API_KEY=

# ── Email (SendGrid) ─────────────────────────────────────────────────────────
EMAIL_PROVIDER=mock           # mock | sendgrid
SENDGRID_API_KEY=
SENDGRID_FROM_DOMAIN=offers.yourbrand.com
SENDGRID_FROM_EMAIL=deals@offers.yourbrand.com
SENDGRID_REPLY_TO=replies@offers.yourbrand.com
# CAN-SPAM: a real physical mailing address is REQUIRED in every send footer.
MAILING_ADDRESS=

# ── AI (Anthropic) ───────────────────────────────────────────────────────────
PERSONALIZER=mock             # mock | anthropic  (outreach personalization)
CLASSIFIER=mock               # mock | anthropic  (intake reply-intent)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Reply intake + gated contracts (services/intake) ─────────────────────────
CONTRACT_STORAGE=mock         # mock | supabase  (where the queued contract PDF lands)
CONTRACTS_BUCKET=contracts
# HARD GATE (PRD §8.3): keep false until a Montana RE attorney reviews the
# assignment template. While false, every generated PDF is stamped DRAFT.
CONTRACT_TEMPLATE_REVIEWED=false
