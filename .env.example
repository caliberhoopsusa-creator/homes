# ── Supabase ────────────────────────────────────────────────────────────────
# Source of truth for the schema is supabase/migrations. Wire your own project.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Property data + skip-trace ───────────────────────────────────────────────
PROPERTY_PROVIDER=mock        # mock | batchdata | firecrawl | county  (sourcing + skiptrace share this)
BATCHDATA_API_KEY=

# Free public-records path (PROPERTY_PROVIDER=county): a JSON array of sources,
# each a normalized-JSON endpoint + the distress signal it implies. A per-county
# adapter/ETL (out of scope) produces the normalized JSON. No paid key needed.
# e.g. [{"url":"https://county.gov/tax-delinquent.json","distress":"tax_delinquent","jurisdiction":"Yellowstone County, MT"}]
COUNTY_RECORDS_SOURCES=

# Firecrawl (web search/scrape/extract). Used for PERMITTED public sources only
# (county tax/foreclosure lists, FSBO, public records). Zillow/Redfin/Trulia/
# Realtor are hard-denied in code per ToS (PRD §8.4).
FIRECRAWL_API_KEY=
FIRECRAWL_REGION=Billings, MT          # localizes the sourcing search query
FIRECRAWL_ALLOW_DOMAINS=               # optional CSV allowlist; empty = all but the denylist
FIRECRAWL_SOURCING_QUERY=              # optional full query override for sourcing

# ── Email (SendGrid) ─────────────────────────────────────────────────────────
EMAIL_PROVIDER=mock           # mock | sendgrid
SENDGRID_API_KEY=
SENDGRID_FROM_DOMAIN=offers.yourbrand.com
SENDGRID_FROM_EMAIL=deals@offers.yourbrand.com
SENDGRID_REPLY_TO=replies@offers.yourbrand.com
# CAN-SPAM: a real physical mailing address is REQUIRED in every send footer.
MAILING_ADDRESS=
# One-click unsubscribe endpoint — point at the desk's handler (writes a suppression).
UNSUBSCRIBE_BASE_URL=https://your-desk-host/api/unsubscribe
OUTREACH_REPLY_TO=replies@offers.yourbrand.com
OUTREACH_FROM_NAME=

# ── AI (Anthropic) ───────────────────────────────────────────────────────────
PERSONALIZER=mock             # mock | anthropic  (outreach personalization)
CLASSIFIER=mock               # mock | anthropic  (intake reply-intent)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Reply intake + gated contracts (services/intake) ─────────────────────────
CONTRACT_STORAGE=mock         # mock | supabase  (where the queued contract PDF lands)
CONTRACTS_BUCKET=contracts
# HARD GATE (PRD §8.3): keep false until a Montana RE attorney reviews the
# assignment template. While false, every generated PDF is stamped DRAFT.
CONTRACT_TEMPLATE_REVIEWED=false
